# ===== SOURCE (your stream recording) =====
SRC_W=2560
SRC_H=1440
# Facecam region INSIDE the source frame (pixels). Measure once per streamer.
FACE_X=79
FACE_Y=360
FACE_W=640
FACE_H=360

# ===== CANVAS =====
OUT_W=1080
OUT_H=1920

# ===== LAYOUT A (blurred bg + center gameplay + facecam bottom-right) =====
A_PANEL_H=1080        # height of the center gameplay panel (1080 = square crop, 1350 = 4:5, 1920 = full height no blur)
A_MAIN_X=auto         # source x of the gameplay crop; "auto" = centered, or a pixel number
A_BLUR=10             # blur strength (applied at 1/4 resolution, cheap on CPU)
A_FACE_W=340          # facecam width on canvas
A_FACE_RIGHT=30       # gap from right edge
A_FACE_BOTTOM=70      # gap from bottom edge

# ===== LAYOUT B (facecam top / gameplay bottom / divider / meme text) =====
B_TOP_PCT=38          # Facecam kitna area lega (35% top, 65% gameplay). Image me approx 35% lag raha hai.
B_MAIN_X=auto         # source x of the gameplay crop; "auto" = centered, or a pixel number
B_DIV_PX=8            # Divider line ki motai (thickness)
B_DIV_COLOR=0xffd23f    # Aap red, yellow ya koi bhi color daal sakte ho.
B_FACE_FIT=cover      # Facecam ko stretch/crop karke top area me perfectly fit karega.

# ===== MEME HOOK TEXT =====
FONT_FILE=fonts/Anton-Regular.ttf
MEME_SIZE=120         # Text ka size bada kar diya hai taaki image jaisa lage
MEME_BORDER=10        # Text ke black outline ki motai
MEME_WRAP=20          # Ek line me kitne characters aayenge
MEME_Y_PCT=15         # Text gameplay area me kitna neeche hoga (15% from top of gameplay)
MEME_SECONDS=0        # 0 ka matlab text poore clip me dikhega

# ===== ENCODER =====
ENCODER=libx264       # libx264 (best quality) or h264_qsv (Intel Quick Sync, faster, test first)
CRF=20
PRESET=medium
